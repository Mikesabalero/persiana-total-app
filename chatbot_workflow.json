    {
      "parameters": {
        "name": "normalizar_telefono",
        "description": "Limpia y normaliza telefonos argentinos a formato estandar de 10 digitos. Recive el telefono en la variable 'phone'.",
        "code": "let phone = $input.first().json.query ? $input.first().json.query.phone : $input.first().json.phone;\nif (!phone) return [{json: {phone: ''}}];\nphone = phone.replace(/[\\s\\-+()]/g, '');\nif (phone.startsWith('54')) phone = phone.substring(2);\nif (phone.startsWith('0')) phone = phone.substring(1);\nif (phone.length > 8 && phone.includes('15') && phone.indexOf('15') > 1 && phone.indexOf('15') <= 4) {\n  phone = phone.replace('15', '4');\n}\nreturn [{json: {phone: phone}}];"
      },
      "id": "6",
      "name": "Normalizar Telefono",
      "type": "n8n-nodes-base.codeTool",
      "typeVersion": 1,
      "position": [ 350, -200 ]
    },
